# Semaphore server root or its /api URL. Keep HTTPS verification enabled.
SEMAPHORE_URL=https://semaphore.example.com
SEMAPHORE_API_TOKEN=replace-with-your-api-token

# Alternatively, remove SEMAPHORE_API_TOKEN and provide both fields below.
# SEMAPHORE_USERNAME=automation-user
# SEMAPHORE_PASSWORD=replace-with-your-password

SEMAPHORE_VERIFY_TLS=true
# SEMAPHORE_CA_BUNDLE=/absolute/path/to/your-ca.pem
SEMAPHORE_TIMEOUT=30
SEMAPHORE_READ_ONLY=false
# Use core for inspection, task runs and logs; full exposes the complete API catalogue.
SEMAPHORE_TOOL_PROFILE=full
# Restrict this MCP server to selected projects; global administration is blocked.
# SEMAPHORE_PROJECT_IDS=1,2

# Required when binding HTTP to a non-loopback address, including in Docker.
# Use a separate long random value; do not reuse your Semaphore API token.
MCP_HTTP_TOKEN=
# Add the host clients use when accessing HTTP through a LAN or reverse proxy.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
# Optional Origin allowlist for MCP HTTP DNS rebinding protection.
# MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*
