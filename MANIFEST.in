include README.md LICENSE pyproject.toml uv.lock .python-version
include CONTRIBUTING.md SECURITY.md CHANGELOG.md
include Dockerfile compose.yaml .dockerignore .env.example .gitlab-ci.yml
recursive-include src/semaphoreui_mcp/data *
recursive-include docs *.md
recursive-include deploy *.service
recursive-include scripts *.py
recursive-include tests *.py
recursive-include .github/workflows *.yml
include .github/dependabot.yml .github/pull_request_template.md
recursive-include .github/ISSUE_TEMPLATE *.yml
global-exclude __pycache__ *.py[cod]
